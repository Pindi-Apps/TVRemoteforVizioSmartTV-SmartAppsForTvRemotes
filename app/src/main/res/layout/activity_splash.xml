<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md3_background"
    tools:context=".activities.SplashActivity">

    <!-- App Logo/Icon with modern elevation -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/md3_surface"
        app:cardCornerRadius="32dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:padding="24dp"
            android:contentDescription="App Icon"
            android:src="@drawable/app_icon" />

    </com.google.android.material.card.MaterialCardView>

    <!-- App Name (Optional - can be added below logo) -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/app_name"
        android:textColor="@color/md3_on_background"
        android:textSize="28sp"
        android:fontFamily="@font/bold"
        android:letterSpacing="0.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressCard"
        android:visibility="gone" />

    <!-- Modern Progress Indicator -->
    <LinearLayout
        android:id="@+id/progressCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Circular Progress Indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:indeterminate="true"
            app:indicatorColor="@color/md3_primary"
            app:indicatorSize="48dp"
            app:trackColor="@color/md3_surface"
            app:trackCornerRadius="24dp"
            app:trackThickness="4dp" />

        <!-- Loading Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading your experience"
            android:textColor="@color/md3_on_background"
            android:textSize="16sp"
            android:fontFamily="@font/albra"
            android:letterSpacing="0.01" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Please wait..."
            android:textColor="@color/md3_on_surface_variant"
            android:textSize="14sp"
            android:fontFamily="@font/albra"
            android:letterSpacing="0.01" />

    </LinearLayout>

    <!-- Ad Notice with modern styling -->
    <TextView
        android:id="@+id/tvAds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:maxLines="2"
        android:paddingHorizontal="20dp"
        android:text="This action can contain Ads"
        android:textColor="@color/md3_on_surface_variant"
        android:textSize="14sp"
        android:fontFamily="@font/albra"
        android:letterSpacing="0.01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
