<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_background"
        android:orientation="vertical">

        <!-- Enhanced Material 3 Header with Gradient Effect -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_surface"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp">

            <!-- Close Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/md3_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivMenu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:contentDescription="Close Menu"
                    app:tint="@color/md3_primary"
                    android:src="@drawable/ic_back" />

            </com.google.android.material.card.MaterialCardView>

            <!-- App Branding -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:fontFamily="@font/bold"
                android:letterSpacing="0.0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Control your TV with ease"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:alpha="0.85"
                android:fontFamily="@font/albra"
                android:letterSpacing="0.01" />

        </LinearLayout>

        <!-- Scrollable Menu Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- General Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="NAVIGATION"
                    android:textColor="@color/md3_primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/bold"
                    android:letterSpacing="0.03" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/md3_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/md3_outline_variant"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <!-- Home Item -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/navHome"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/md3_surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:background="?attr/selectableItemBackground"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    app:cardBackgroundColor="@color/feature_quaternary"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:layout_width="26dp"
                                        android:layout_height="26dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Home Icon"
                                        app:tint="@color/white"
                                        android:src="@drawable/ic_baseline_home_24" />

                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Home"
                                        android:textColor="@color/md3_on_surface"
                                        android:textSize="16sp"
                                        android:fontFamily="@font/bold"
                                        android:letterSpacing="0.0" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Return to main screen"
                                        android:maxLines="1"
                                        android:textColor="@color/md3_on_surface_variant"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/albra"
                                        android:letterSpacing="0.01" />

                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- WiFi Status Item -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/llWifi"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/md3_surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:background="?attr/selectableItemBackground"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    app:cardBackgroundColor="@color/md3_primary"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:id="@+id/ivWifi"
                                        android:layout_width="26dp"
                                        android:layout_height="26dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="WiFi Icon"
                                        app:tint="@color/white"
                                        android:src="@drawable/ic_wifi_connected" />

                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvWifiStatus"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Wifi Connected"
                                        android:textColor="@color/md3_on_surface"
                                        android:textSize="16sp"
                                        android:fontFamily="@font/bold"
                                        android:letterSpacing="0.0" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Network status information"
                                        android:maxLines="1"
                                        android:textColor="@color/md3_on_surface_variant"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/albra"
                                        android:letterSpacing="0.01" />

                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Privacy Policy Item -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivPrivacy"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/md3_surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:background="?attr/selectableItemBackground"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    app:cardBackgroundColor="@color/feature_tertiary"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:layout_width="26dp"
                                        android:layout_height="26dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Privacy Icon"
                                        app:tint="@color/white"
                                        android:src="@drawable/ic_privacy" />

                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Privacy Policy"
                                        android:textColor="@color/md3_on_surface"
                                        android:textSize="16sp"
                                        android:fontFamily="@font/bold"
                                        android:letterSpacing="0.0" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Review our privacy terms"
                                        android:maxLines="1"
                                        android:textColor="@color/md3_on_surface_variant"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/albra"
                                        android:letterSpacing="0.01" />

                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- About & Support Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="SUPPORT"
                    android:textColor="@color/md3_primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/bold"
                    android:letterSpacing="0.03" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/md3_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/md3_outline_variant"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <!-- Share App Item -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/llShare"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/md3_surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:background="?attr/selectableItemBackground"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    app:cardBackgroundColor="@color/feature_primary"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:layout_width="26dp"
                                        android:layout_height="26dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Share Icon"
                                        app:tint="@color/white"
                                        android:src="@drawable/ic_new_share" />

                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Share App"
                                        android:textColor="@color/md3_on_surface"
                                        android:textSize="16sp"
                                        android:fontFamily="@font/bold"
                                        android:letterSpacing="0.0" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Share with friends and family"
                                        android:maxLines="1"
                                        android:textColor="@color/md3_on_surface_variant"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/albra"
                                        android:letterSpacing="0.01" />

                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Rate Us Item -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/navRate"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/md3_surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:background="?attr/selectableItemBackground"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    app:cardBackgroundColor="@color/feature_secondary"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:layout_width="26dp"
                                        android:layout_height="26dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Rating Icon"
                                        app:tint="@color/white"
                                        android:src="@drawable/ic_star" />

                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Rate Us"
                                        android:textColor="@color/md3_on_surface"
                                        android:textSize="16sp"
                                        android:fontFamily="@font/bold"
                                        android:letterSpacing="0.0" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Help us improve with your rating"
                                        android:maxLines="1"
                                        android:textColor="@color/md3_on_surface_variant"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/albra"
                                        android:letterSpacing="0.01" />

                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- More Apps Item -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/navMoreApps"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/md3_surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:background="?attr/selectableItemBackground"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    app:cardBackgroundColor="@color/md3_primary"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:layout_width="26dp"
                                        android:layout_height="26dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="More Apps Icon"
                                        app:tint="@color/white"
                                        android:src="@drawable/ic_more_app" />

                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:text="More Apps"
                                    android:textColor="@color/md3_on_surface"
                                    android:textSize="16sp"
                                    android:fontFamily="@font/bold"
                                    android:letterSpacing="0.0" />

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardBackgroundColor="@color/feature_secondary"
                                    app:cardCornerRadius="8dp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="5dp"
                                        android:text="AD"
                                        android:textColor="@color/white"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/bold"
                                        android:letterSpacing="0.03" />

                                </com.google.android.material.card.MaterialCardView>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</layout>
