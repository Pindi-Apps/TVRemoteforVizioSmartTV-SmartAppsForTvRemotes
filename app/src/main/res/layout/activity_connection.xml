<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md3_background"
    tools:context=".activities.ConnectionActivity">

    <!-- Material 3 AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md3_surface"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md3_surface">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Back"
                    app:tint="@color/md3_on_surface"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connection"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="24sp"
                    android:fontFamily="@font/bold"
                    android:letterSpacing="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- Cast Icon Container -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_cast_icon_container">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cast"
                    app:tint="@color/md3_primary" />

            </FrameLayout>

            <!-- Connection Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Connect to Your Device"
                android:textColor="@color/md3_on_surface"
                android:textSize="26sp"
                android:fontFamily="@font/bold"
                android:letterSpacing="0.0"
                android:gravity="center" />

            <!-- Connection Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:text="Tap the button below to discover and connect to your smart TV or casting device"
                android:textColor="@color/md3_on_surface_variant"
                android:textSize="16sp"
                android:fontFamily="@font/albra"
                android:letterSpacing="0.01"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <!-- Connect Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginHorizontal="16dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/md3_primary"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_wifi_connected"
                        app:tint="@color/md3_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Tap to Connect"
                        android:textColor="@color/md3_background"
                        android:textSize="17sp"
                        android:fontFamily="@font/bold"
                        android:letterSpacing="0.0" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Connection Tips Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@color/md3_surface_variant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Tips Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_help"
                            app:tint="@color/md3_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Connection Tips"
                            android:textColor="@color/md3_on_surface"
                            android:textSize="17sp"
                            android:fontFamily="@font/bold"
                            android:letterSpacing="0.0" />

                    </LinearLayout>

                    <!-- Tip 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="start">

                        <TextView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_cast_icon_container"
                            android:backgroundTint="@color/md3_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Make sure your device and TV are on the same WiFi network"
                            android:textColor="@color/md3_on_surface_variant"
                            android:textSize="15sp"
                            android:fontFamily="@font/albra"
                            android:letterSpacing="0.01"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                    <!-- Tip 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="start">

                        <TextView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_cast_icon_container"
                            android:backgroundTint="@color/md3_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Enable casting or screen mirroring on your TV"
                            android:textColor="@color/md3_on_surface_variant"
                            android:textSize="15sp"
                            android:fontFamily="@font/albra"
                            android:letterSpacing="0.01"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                    <!-- Tip 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="start">

                        <TextView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_cast_icon_container"
                            android:backgroundTint="@color/md3_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Keep your TV turned on during connection"
                            android:textColor="@color/md3_on_surface_variant"
                            android:textSize="15sp"
                            android:fontFamily="@font/albra"
                            android:letterSpacing="0.01"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
