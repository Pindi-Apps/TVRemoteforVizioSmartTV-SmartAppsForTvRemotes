<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_color"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
       >

        <TextView
            android:id="@+id/pairing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:text="@string/pairing_explanation"
            android:textColor="@color/white"
            android:textSize="15dp" />
        <TextView
            android:id="@+id/pairing_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/pairing_text"
            android:layout_marginBottom="10dp"
            android:text="Unlocking Entertainment: Enter the Code, Ignite the Connection!"
            android:textColor="@color/white"
            android:textSize="13dp" />

        <EditText
            android:id="@+id/pairing_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/pairing_desc"
            android:layout_centerHorizontal="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/pairing_pin_hint"
            android:inputType="number"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:textColor="@color/white"
            >

            <requestFocus />
        </EditText>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_below="@+id/pairing_pin"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pairing_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/oval_buttons_fs"
                android:singleLine="true"
                android:text="Cancel" />

            <Button
                android:id="@+id/pairing_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:background="@drawable/oval_buttons_fs"
                android:singleLine="true"
                android:text="Pair" />

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
