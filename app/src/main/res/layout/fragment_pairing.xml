<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_color"
    android:orientation="vertical">
<RelativeLayout
    android:layout_margin="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_color">
    <TextView
        android:id="@+id/pairing_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp"
        android:layout_alignParentTop="true"
        android:fontFamily="serif"
        android:layout_marginBottom="10dp"
        android:text="Enter The Pairing Code displayed on TV"
        android:textSize="15dp"
        android:textColor="@color/white" />

    <EditText
        android:id="@+id/pairing_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/pairing_text"
        android:layout_centerHorizontal="true"
        android:textColor="@color/black"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:textColorHint="@color/black"
        android:hint="0000">
        <requestFocus />
    </EditText>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/pairing_pin"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pairing_cancel"
            android:layout_width="120dp"
            android:layout_height="45dp"
            android:text="Cancel"
            android:fontFamily="serif-monospace"
            android:backgroundTint="@color/black"
            app:cornerRadius="40dp"
            android:singleLine="true"
            android:layout_marginHorizontal="10dp"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pairing_ok"
            android:layout_width="120dp"
            android:layout_height="45dp"
            android:fontFamily="serif-monospace"
            android:text="Pair"
            app:cornerRadius="40dp"
            android:layout_marginHorizontal="10dp"
            android:backgroundTint="@color/black"
            android:singleLine="true"/>

    </LinearLayout>
</RelativeLayout>

</RelativeLayout>
