<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_color"
    tools:context=".activities.WifiRemoteActivity">
    <View
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#0662C3"
        android:id="@+id/toolBar"/>
    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:id="@+id/ivBack"
        app:layout_constraintStart_toStartOf="@+id/toolBar"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="@+id/toolBar"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="@+id/toolBar"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/toolBar"
        android:text="Search Wifi Remote"
        android:textColor="@color/white"
        android:fontFamily="serif"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/toolBar"
        app:layout_constraintStart_toStartOf="@+id/toolBar"
        app:layout_constraintEnd_toEndOf="@+id/toolBar"
        />
    <TextView
        android:layout_width="0dp"
        android:id="@+id/tvTop"
        android:layout_height="60dp"
        android:text="Searching For VIZIO SmartCast TV.."
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/toolBar"
        android:textStyle="bold"
        android:textSize="18sp"
        android:fontFamily="serif"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tvTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        app:strokeColor="@color/white"
        android:id="@+id/cvRemote"
        app:cardBackgroundColor="@color/bg_color"
        app:strokeWidth="1dp"
        android:layout_marginHorizontal="10dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                >

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1"

                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="Device Name:"
                        android:textColor="@color/white"
                        android:gravity="start"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="Office TV(Vizio+D40f-J09 )"
                        android:textColor="@color/white"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:gravity="start"
                        android:fontFamily="serif"
                        android:layout_marginBottom="5dp"

                        android:textSize="12sp"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="10dp"
                        />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="70dp"
                    android:background="@color/white"
                    />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="Device Ip Address:"
                        android:textColor="@color/white"
                        android:gravity="start"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:textColor="@color/white"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:layout_marginBottom="5dp"

                        android:layout_marginTop="5dp"
                        android:text="192.168.18.101"
                        />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progressSearch"
        app:layout_constraintTop_toBottomOf="@+id/tvTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintBottom_toTopOf="@+id/tvBottom"
        />
<TextView
    android:layout_width="wrap_content"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_height="wrap_content"
    android:textColor="@color/white"
    android:fontFamily="serif"
    android:id="@+id/tvBottom"
    app:layout_constraintBottom_toBottomOf="parent"
    android:gravity="center"
    android:layout_marginBottom="20dp"
    android:text="Please Contact your VIZIO SmartCast TV and your\n Mobile Phone to the same Wifi Network"
    />
</androidx.constraintlayout.widget.ConstraintLayout>