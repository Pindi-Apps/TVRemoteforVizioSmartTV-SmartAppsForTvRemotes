<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/remote_background_color"
    android:orientation="vertical"
    tools:context=".activities.RemoteViewActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_55sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:id="@+id/power"
                    android:backgroundTint="@android:color/holo_red_light"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/_10sdp"
                        android:src="@drawable/ic_power"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:visibility="invisible"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/_10sdp"
                        android:src="@drawable/ic_back"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:visibility="invisible"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/_10sdp"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:id="@+id/btn_av"
                    android:backgroundTint="@color/bg_color"
                    android:orientation="horizontal"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <TextView
                        style="@style/textHeading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:padding="@dimen/_10sdp"
                        android:text="Av/Tv"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>


            <FrameLayout
                android:id="@+id/llDial"
                android:layout_width="@dimen/_320sdp"
                android:layout_height="@dimen/_320sdp"
                android:layout_gravity="center"
                android:elevation="@dimen/_10sdp"
                android:orientation="vertical">


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_shades"
                    app:tint="@color/white" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/_30sdp"
                    android:background="@drawable/bg_center_oval"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/button_up"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:rotation="-90"
                            android:src="@drawable/ic_play"
                            app:tint="@color/white" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/button_left"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_50sdp"
                                android:rotation="180"
                                android:src="@drawable/ic_play"
                                app:tint="@color/white" />

                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/button_ok"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/bg_shades"
                                app:tint="@color/white" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="@dimen/_8sdp"
                                android:background="@drawable/bg_center_oval"
                                android:gravity="center"
                                android:orientation="vertical">


                                <TextView
                                    style="@style/textHeading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:text="OK"
                                    android:textColor="@color/white"
                                    android:textSize="20sp" />
                            </LinearLayout>


                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/button_right"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical|end">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_50sdp"
                                android:src="@drawable/ic_play"
                                app:tint="@color/white" />

                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/button_down"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:rotation="90"
                            android:src="@drawable/ic_play"
                            app:tint="@color/white" />

                    </LinearLayout>


                </LinearLayout>


            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:id="@+id/r_buttton"
                    android:backgroundTint="@android:color/holo_red_light"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <TextView
                        style="@style/textHeading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="R"
                        android:textColor="@color/white" />

                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:id="@+id/g_buttton"
                    android:backgroundTint="@android:color/holo_green_light"
                    android:orientation="horizontal"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <TextView
                        style="@style/textHeading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="G"
                        android:textColor="@color/white" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:id="@+id/y_buttton"
                    android:backgroundTint="#C9F2F233"
                    android:orientation="horizontal"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <TextView
                        style="@style/textHeading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Y"
                        android:textColor="@color/white" />

                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:id="@+id/b_buttton"
                    android:backgroundTint="@color/black"
                    android:orientation="horizontal"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <TextView
                        style="@style/textHeading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="@color/white" />

                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_200sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/bg_color"
                    android:orientation="horizontal"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivVolumePlus"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/textHeading"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="VOL"
                            android:textColor="@color/white"
                            android:textSize="15sp" />


                        <ImageView
                            android:id="@+id/ivVolumeMinus"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/ic_minus_round"
                            app:tint="@color/white" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_weight="2"
                    android:orientation="vertical">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:id="@+id/index"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:backgroundTint="@color/bg_color"
                        android:orientation="horizontal"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <TextView
                            style="@style/textHeading"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:padding="@dimen/_10sdp"
                            android:text="Index"
                            android:textColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_gravity="center"
                        android:id="@+id/chanel_list"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:backgroundTint="@color/bg_color"
                        android:orientation="horizontal"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <TextView
                            style="@style/textHeading"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:padding="@dimen/_10sdp"
                            android:text="CH-List"
                            android:textColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_gravity="bottom"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:backgroundTint="@color/bg_color"
                        android:id="@+id/menu"
                        android:orientation="horizontal"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <TextView
                            style="@style/textHeading"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:padding="@dimen/_10sdp"
                            android:text="Menu"
                            android:textColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvMute"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_gravity="bottom"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:backgroundTint="@color/bg_color"
                        android:orientation="horizontal"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <TextView
                            style="@style/textHeading"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:padding="@dimen/_10sdp"
                            android:text="Mute"
                            android:textColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_200sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/bg_color"
                    android:orientation="horizontal"
                    app:cardCornerRadius="@dimen/remote_card_radius"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivChannelUp"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:padding="@dimen/_8sdp"
                            android:rotation="90"
                            android:src="@drawable/round_arrow_back_ios_24"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/textHeading"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="CH"
                            android:textColor="@color/white"
                            android:textSize="15sp" />


                        <ImageView
                            android:id="@+id/ivChannelDown"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:padding="@dimen/_8sdp"
                            android:rotation="-90"
                            android:src="@drawable/round_arrow_back_ios_24"
                            app:tint="@color/white" />


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>


        </LinearLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>