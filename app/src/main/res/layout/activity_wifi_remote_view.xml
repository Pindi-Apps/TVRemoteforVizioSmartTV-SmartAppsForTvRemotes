<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/remote_background_color"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_55sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/power_off_vizio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@android:color/holo_red_light"
                android:orientation="horizontal"
                android:visibility="visible"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_power"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="invisible"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvRemoteCircle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_color"
                android:orientation="horizontal"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_remote_circle"
                    app:tint="@color/white" />


            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvTouch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_color"
                android:orientation="horizontal"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/round_touch_app_24"
                    app:tint="@color/white" />

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_320sdp">


            <FrameLayout
                android:id="@+id/llDial"
                android:layout_width="@dimen/_320sdp"
                android:layout_height="@dimen/_320sdp"
                android:layout_gravity="center"
                android:elevation="@dimen/_10sdp"
                android:orientation="vertical">


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_shades"
                    app:tint="@color/white" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/_30sdp"
                    android:background="@drawable/bg_center_oval"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ok_up"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:rotation="-90"
                            android:src="@drawable/ic_play"
                            app:tint="@color/white" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/ok_left"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_50sdp"
                                android:rotation="180"
                                android:src="@drawable/ic_play"
                                app:tint="@color/white" />

                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/ok_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/bg_shades"
                                app:tint="@color/white" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="@dimen/_8sdp"
                                android:background="@drawable/bg_center_oval"
                                android:gravity="center"
                                android:orientation="vertical">


                                <TextView
                                    style="@style/textHeading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:text="OK"
                                    android:textColor="@color/white"
                                    android:textSize="20sp" />
                            </LinearLayout>


                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/ok_right"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical|end">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_50sdp"
                                android:src="@drawable/ic_play"
                                app:tint="@color/white" />

                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ok_down"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:rotation="90"
                            android:src="@drawable/ic_play"
                            app:tint="@color/white" />

                    </LinearLayout>


                </LinearLayout>


            </FrameLayout>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:id="@+id/cvTouchPad"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginVertical="@dimen/_10sdp"
                android:layout_height="match_parent"
                app:cardElevation="5dp"
                android:visibility="invisible"
                app:cardCornerRadius="@dimen/remote_card_radius"
                android:backgroundTint="@color/bg_color"
                android:layout_gravity="center">
                <RelativeLayout
                    android:id="@+id/rlTouch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_55sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:id="@+id/cvMute"
                android:backgroundTint="@color/bg_color"
                android:orientation="horizontal"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/mute"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:id="@+id/back_button"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:backgroundTint="@color/bg_color"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_weight="1"
                android:id="@+id/buttonhome"
                android:backgroundTint="@color/bg_color"
                android:orientation="horizontal"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/round_home_24"
                    app:tint="@color/white" />


            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:id="@+id/info_button"
                android:backgroundTint="@color/bg_color"
                android:orientation="horizontal"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_setting"
                    app:tint="@color/white" />

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="@dimen/_200sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_color"
                android:orientation="horizontal"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/volume_up"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/white" />

                    <TextView
                        style="@style/textHeading"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="VOL"
                        android:textColor="@color/white"
                        android:textSize="15sp" />


                    <ImageView
                        android:id="@+id/volume_down"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/ic_minus_round"
                        app:tint="@color/white" />


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_weight="2"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_55sdp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/button_menu"
                        android:backgroundTint="@color/bg_color"
                        android:orientation="horizontal"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_10sdp"
                            android:text="Menu"
                            style="@style/textHeading"
                            android:textColor="@color/white"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center"
                            />

                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/button_source"
                        android:orientation="horizontal"
                        android:backgroundTint="@color/bg_color"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_10sdp"
                            android:text="Input"
                            style="@style/textHeading"
                            android:textColor="@color/white"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center"
                            />

                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_55sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/play_button"
                        android:backgroundTint="@color/bg_color"
                        android:orientation="horizontal"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_10sdp"
                            android:text="Play"
                            style="@style/textHeading"
                            android:textColor="@color/white"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center"
                            />

                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/cvChannels"
                        android:orientation="horizontal"
                        android:backgroundTint="@android:color/holo_blue_light"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_10sdp"
                            android:src="@drawable/ic_channel"
                            app:tint="@color/white" />

                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_55sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/freverse"
                        android:backgroundTint="@color/bg_color"
                        android:orientation="horizontal"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_10sdp"
                            android:src="@drawable/ic_rewind"
                            app:tint="@color/white" />

                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/fforward"
                        android:orientation="horizontal"
                        android:backgroundTint="@color/bg_color"
                        app:cardCornerRadius="@dimen/remote_card_radius"
                        app:cardElevation="@dimen/_4sdp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_10sdp"
                            android:src="@drawable/ic_forward"
                            app:tint="@color/white" />


                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>



            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="@dimen/_200sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_color"
                android:orientation="horizontal"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/channel_up"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="@dimen/_8sdp"
                        android:rotation="90"
                        android:src="@drawable/round_arrow_back_ios_24"
                        app:tint="@color/white" />

                    <TextView
                        style="@style/textHeading"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="CH"
                        android:textColor="@color/white"
                        android:textSize="15sp" />


                    <ImageView
                        android:id="@+id/channel_down"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="@dimen/_8sdp"
                        android:rotation="-90"
                        android:src="@drawable/round_arrow_back_ios_24"
                        app:tint="@color/white" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_55sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@android:color/holo_red_light"
                android:orientation="horizontal"
                android:id="@+id/youtube_vizio"
                android:visibility="visible"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:text="Youtube"
                    style="@style/textHeading"
                    android:textColor="@color/white"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    />
            </com.google.android.material.card.MaterialCardView>



            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:id="@+id/watchfree_vizio"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_5sdp"
                android:backgroundTint="@android:color/holo_orange_light"
                android:orientation="horizontal"
                android:visibility="visible"
                app:cardCornerRadius="@dimen/remote_card_radius"
                app:cardElevation="@dimen/_4sdp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp"
                    android:text="Watch+ Free"
                    style="@style/textHeading"
                    android:textColor="@color/white"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    />
            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            />







    </LinearLayout>


</ScrollView>