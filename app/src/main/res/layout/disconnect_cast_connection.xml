<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="@dimen/_12sdp"
        app:cardElevation="@dimen/_4sdp"
        app:contentPadding="@dimen/_15sdp"
        app:strokeWidth="0dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_80sdp"
                android:layout_gravity="center"
                android:src="@drawable/castvizio"
                app:tint="@color/app_color_2" />


            <TextView
                style="@style/textHeading"
                android:text="Device Disconnect"
                android:textSize="20sp" />


            <TextView
                style="@style/textNormal"
                android:layout_marginTop="@dimen/_3sdp"
                android:text="Are you sure you want to Disconnect this Cast Connection?" />


            <!--            <TextView-->
            <!--                android:layout_marginTop="@dimen/_3sdp"-->
            <!--                style="@style/textNormal"-->
            <!--                android:textColor="@android:color/holo_red_light"-->
            <!--                android:text="@string/if_you_are_disconnect_then_next_media_does_not_play_in_the_tv"-->
            <!--                />-->


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDisconnect"
                        style="@style/textNormal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:backgroundTint="@color/app_color_2"
                        android:includeFontPadding="false"
                        android:text="Disconnect"
                        android:textColor="@color/white"
                        app:cornerRadius="@dimen/remote_card_radius" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNo"
                        style="@style/textNormal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:backgroundTint="@color/bg_color"
                        android:includeFontPadding="false"
                        android:text="@string/no"
                        android:textColor="@color/white"
                        app:cornerRadius="@dimen/remote_card_radius" />


                </LinearLayout>


            </LinearLayout>


        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>


</layout>